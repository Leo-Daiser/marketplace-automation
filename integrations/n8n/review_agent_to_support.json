{
  "name": "Отзывы в backlog поддержки",
  "nodes": [
    {
      "parameters": {
        "path": "reviews/analyze",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "reviews-webhook",
      "name": "Webhook отзывов",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/reviews/drafts",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { rows: $json.rows || [$json] } }}"
      },
      "id": "call-review-api",
      "name": "Вызвать API отзывов",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ ($json.tickets || []).length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "has-tickets",
      "name": "Есть обращения",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "documentId": "GOOGLE_SHEET_ID",
        "sheetName": "support_tickets",
        "columns": {
          "mappingMode": "autoMapInputData"
        },
        "options": {}
      },
      "id": "append-support-ticket",
      "name": "Записать обращения в поддержку",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [960, 220],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "chatId": "TELEGRAM_CHAT_ID",
        "text": "={{ `Агент отзывов обработал ${( $json.replies || [] ).length} отзывов. Обращения: ${( $json.tickets || [] ).length}` }}"
      },
      "id": "telegram-review-summary",
      "name": "Сводка в Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [960, 380],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Webhook отзывов": {
      "main": [[{ "node": "Вызвать API отзывов", "type": "main", "index": 0 }]]
    },
    "Вызвать API отзывов": {
      "main": [[{ "node": "Есть обращения", "type": "main", "index": 0 }]]
    },
    "Есть обращения": {
      "main": [
        [{ "node": "Записать обращения в поддержку", "type": "main", "index": 0 }],
        [{ "node": "Сводка в Telegram", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "template"
}
