{
  "name": "Отчет по рекламе в Telegram",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "cron-daily-ads",
      "name": "Ежедневно 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "documentId": "GOOGLE_SHEET_ID",
        "sheetName": "ads_daily",
        "options": {}
      },
      "id": "read-ads-sheet",
      "name": "Прочитать ads_daily",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [460, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/ads/report",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { rows: $items().map(item => item.json), target_drr: 0.18 } }}"
      },
      "id": "call-ads-api",
      "name": "Вызвать API рекламы",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [700, 300]
    },
    {
      "parameters": {
        "jsCode": "const rows = $json.rows || [];\nconst risks = rows.filter(r => !['monitor','scale_budget'].includes(r.recommended_action));\nconst spend = rows.reduce((s, r) => s + Number(r.spend_rub || 0), 0);\nconst revenue = rows.reduce((s, r) => s + Number(r.revenue_rub || 0), 0);\nconst drr = revenue ? (spend / revenue * 100).toFixed(1) : '0.0';\nreturn [{ json: { text: `Ежедневный отчет по рекламе\\nРасход: ${spend.toFixed(0)} RUB\\nВыручка: ${revenue.toFixed(0)} RUB\\nДРР: ${drr}%\\nРисковые кампании: ${risks.length}` } }];"
      },
      "id": "format-telegram",
      "name": "Сформировать сообщение Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 300]
    },
    {
      "parameters": {
        "chatId": "TELEGRAM_CHAT_ID",
        "text": "={{ $json.text }}"
      },
      "id": "send-telegram",
      "name": "Отправить в Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1160, 300],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Ежедневно 09:00": {
      "main": [[{ "node": "Прочитать ads_daily", "type": "main", "index": 0 }]]
    },
    "Прочитать ads_daily": {
      "main": [[{ "node": "Вызвать API рекламы", "type": "main", "index": 0 }]]
    },
    "Вызвать API рекламы": {
      "main": [[{ "node": "Сформировать сообщение Telegram", "type": "main", "index": 0 }]]
    },
    "Сформировать сообщение Telegram": {
      "main": [[{ "node": "Отправить в Telegram", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "template"
}
